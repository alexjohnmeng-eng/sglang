+    const auto split_barriers = arch_major == 9
+        ? torch::empty({mhc_layout::kNumSplitBarriers, mhc_layout::kNumMaxMBlocks,
+                        mhc_layout::kSplitBarrierLineBytes}, x.options().dtype(torch::kByte))
