diff --git a/csrc/apis/h20.hpp b/csrc/apis/h20.hpp
new file mode 100644
index 0000000..9783095
--- /dev/null
+++ b/csrc/apis/h20.hpp
@@ -0,0 +1,37 @@
+#pragma once
+#include <torch/library.h>
+namespace deep_gemm::h20 {
+using torch::Tensor;
+void dg_dsv41_wqb_q8_rope(const Tensor& a, const Tensor& a_sf, const Tensor& b, const Tensor& b_sf,
+                         const Tensor& d, const Tensor& positions, const Tensor& freqs) {
+    const int m = static_cast<int>(a.size(0));
+    constexpr int n = 32768, k = 1280;
+    DG_HOST_ASSERT(jit->device.get_arch_major() == 9 and m >= 8192 and m % 256 == 0);
+    DG_HOST_ASSERT(a.sizes() == at::IntArrayRef({m, k}) and b.sizes() == at::IntArrayRef({n, k}));
+    DG_HOST_ASSERT(d.sizes() == at::IntArrayRef({m, n}) and d.is_contiguous());
+    DG_HOST_ASSERT(positions.sizes() == at::IntArrayRef({m}) and positions.scalar_type() == torch::kInt64);
+    DG_HOST_ASSERT(freqs.dim() == 2 and freqs.size(1) == 64 and freqs.scalar_type() == torch::kFloat);
+    for (const auto* t : {&a, &a_sf, &b, &b_sf, &d, &positions, &freqs})
+        DG_HOST_ASSERT(t->is_cuda() and t->device() == a.device());
+    DG_HOST_ASSERT(positions.is_contiguous() and freqs.is_contiguous());
+    DG_HOST_ASSERT(a.scalar_type() == torch::kFloat8_e4m3fn and b.scalar_type() == a.scalar_type());
+    std::optional<std::tuple<int, int, int>> recipe = std::make_tuple(1, 32, 32);
+    std::optional<std::tuple<int, int>> recipe_a, recipe_b;
+    const auto [sfa, sfb, gran_k_a, gran_k_b] = layout::transform_sf_pair_into_required_layout(
+        a_sf, b_sf, m, n, k, recipe, recipe_a, recipe_b, std::nullopt, std::nullopt, false);
+    const auto major_a = get_major_type_ab(a);
+    const auto major_b = get_major_type_ab(b);
+    sm90_fp8_gemm_1d2d(a, sfa, b, sfb, std::nullopt, d, m, n, k, major_a, major_b,
+                       get_major_type_ab(sfb), "", std::nullopt, 32, &positions, &freqs);
+}
+
+static void register_apis(pybind11::module_& m) {
+    m.def("dsv41_wqb_q8_rope", &dg_dsv41_wqb_q8_rope);
+}
+} // namespace deep_gemm::h20
+TORCH_LIBRARY_FRAGMENT(deep_gemm, ops) {
+    ops.def("dsv41_wqb_q8_rope(Tensor a, Tensor a_sf, Tensor b, Tensor b_sf, Tensor(a!) d, Tensor positions, Tensor freqs) -> ()");
+}
+TORCH_LIBRARY_IMPL(deep_gemm, CUDA, ops) {
+    ops.impl("dsv41_wqb_q8_rope", &deep_gemm::h20::dg_dsv41_wqb_q8_rope);
+}
