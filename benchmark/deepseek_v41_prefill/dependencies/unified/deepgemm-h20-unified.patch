+// A task is one (m-block, K-split) pair, subdivided into BLOCK_K blocks.
+// MMA_K is the per-route hidden width of one TF32 MMA instruction.
+constexpr uint32_t MMA_K = 32 / sizeof(float);
+constexpr uint32_t kNumTokenRowsPerLane = 2;
+
+} // namespace mega_mhc
